    </div>

    <!-- Featured Content Section -->
    <MudGrid>
        <!-- Recent Blog Posts -->
        <MudItem xs="12" md="7">
            <!-- Section header -->
            <div class="d-flex align-center mb-5" style="gap: 12px;">
                <div style="width: 4px; height: 28px; background: linear-gradient(180deg, var(--mud-palette-primary), #FF9A6C); border-radius: 2px; flex-shrink: 0;"></div>
                <MudText Typo="Typo.h5" Class="font-weight-bold">Latest Articles</MudText>
                <MudSpacer />
                <MudLink Href="/blog" Color="Color.Primary" Underline="Underline.None" Class="font-weight-bold" Style="font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase;">All Posts →</MudLink>
            </div>

            @if (_isLoadingPosts)
            {
                <div class="d-flex justify-center my-8">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                </div>
            }
            else if (_posts == null || !_posts.Any())
            {
                <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined" Class="mud-theme-primary">
                    No articles published yet. Check back soon!
                </MudAlert>
            }
            else
            {
                <div class="d-flex flex-column gap-4">
                    @foreach (var post in _posts)
                    {
                        <a href="/blog/@post.Slug" class="featured-post-link">
                            <MudPaper Elevation="0" Class="pa-5 rounded-lg"
                                      Style="background-color: var(--mud-palette-surface); border: 1px solid var(--mud-palette-lines-default); transition: border-color 0.2s, box-shadow 0.2s;">
                                <div class="d-flex justify-space-between align-center mb-2">
                                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Text" Size="Size.Small"
                                             Class="font-weight-bold ma-0 pa-0"
                                             Style="font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; height: auto; background: transparent;">
                                        @(post.Category?.Title ?? "General")
                                    </MudChip>
                                    <MudText Typo="Typo.caption" Color="Color.Default">@post.Created.ToString("MMM dd, yyyy")</MudText>
                                </div>
                                <MudText Typo="Typo.h6" Class="font-weight-bold mb-2" Style="line-height: 1.3;">@post.Title</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Default" Class="mb-3" Style="line-height: 1.55;">
                                    @(string.IsNullOrWhiteSpace(post.Excerpt) ? (post.Body.Length > 150 ? post.Body[..147] + "..." : post.Body) : post.Excerpt)
                                </MudText>
                                <MudText Color="Color.Primary" Class="font-weight-bold" Style="font-size: 0.8rem; letter-spacing: 0.05em;">Read More →</MudText>
                            </MudPaper>
                        </a>
                    }
                </div>
            }
        </MudItem>

        <!-- Featured Project -->
        <MudItem xs="12" md="5">
            <!-- Section header -->
            <div class="d-flex align-center mb-5" style="gap: 12px;">
                <div style="width: 4px; height: 28px; background: linear-gradient(180deg, var(--mud-palette-primary), #FF9A6C); border-radius: 2px; flex-shrink: 0;"></div>
                <MudText Typo="Typo.h5" Class="font-weight-bold">Featured Projects</MudText>
                <MudSpacer />
                <MudLink Href="/projects" Color="Color.Primary" Underline="Underline.None" Class="font-weight-bold" Style="font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase;">All Projects →</MudLink>
            </div>

            @if (_isLoadingProjects)
            {
                <div class="d-flex justify-center my-8">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                </div>
            }
            else if (_featuredProjects == null || !_featuredProjects.Any())
            {
                <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined" Class="mud-theme-primary">
                    No projects listed yet.
                </MudAlert>
            }
            else
            {
                <div class="d-flex flex-column gap-4">
                    @foreach (var project in _featuredProjects)
                    {
                        <a href="/projects/@project.Slug" class="featured-spotlight-link">
                            <div class="featured-spotlight rounded-lg d-flex flex-column">
                                <div class="pa-5 d-flex flex-column gap-2 h-100">
                                    <div class="d-flex align-center gap-3 mb-2">
                                        <div class="spotlight-icon-wrapper d-flex align-center justify-center rounded-lg">
                                            <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Style="font-size: 1.3rem; color: white;" />
                                        </div>
                                        <MudText Typo="Typo.h6" Class="font-weight-bold mb-0" Style="line-height: 1.3; flex: 1;">@project.Title</MudText>
                                    </div>

                                    <MudText Typo="Typo.body2" Color="Color.Default" Style="line-height: 1.55;" Class="spotlight-summary">
                                        @project.Summary
                                    </MudText>

                                    <MudText Color="Color.Primary" Class="font-weight-bold d-flex align-center" Style="font-size: 0.8rem; letter-spacing: 0.05em; gap: 4px; margin-top: auto;">
                                        View Project
                                        <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
                                    </MudText>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            }
        </MudItem>
    </MudGrid>

</MudContainer>

@code {
    private List<PostDto> _posts = [];
    private List<ProjectDto> _featuredProjects = [];
    private bool _isLoadingPosts = true;
    private bool _isLoadingProjects = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var featuredRequest = new GetFeaturedPostsRequest { PageSize = 3 };
            var result = await PostService.GetFeaturedAsync(featuredRequest);
            _posts = result.Items;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load featured posts");
            _posts = [];
        }
        finally
        {
            _isLoadingPosts = false;
        }

        try
        {
            var projectsRequest = new GetFeaturedProjectsRequest { PageSize = 3 };
            var result = await ProjectService.GetFeaturedAsync(projectsRequest);
            _featuredProjects = result.Items;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load featured projects");
            _featuredProjects = [];
        }
        finally
        {
            _isLoadingProjects = false;
        }
    }
}

