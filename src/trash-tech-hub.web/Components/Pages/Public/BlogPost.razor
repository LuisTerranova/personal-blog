@page "/blog/{Slug}"
@using TrashTechHub.Core.Requests.Posts
@using TrashTechHub.Core.Models
@inject IPostService PostService
@inject NavigationManager NavigationManager

<MudContainer MaxWidth="MaxWidth.Medium" Class="my-12">
    <!-- Back to blog link -->
    <MudButton StartIcon="@Icons.Material.Filled.ArrowBack" 
               Color="Color.Primary" 
               Href="/blog" 
               Class="mb-6 font-weight-bold"
               Style="text-transform: none;">
        Back to Blog
    </MudButton>

    @if (_isLoading)
    {
        <div class="d-flex justify-center my-16">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        </div>
    }
    else if (_errorMessage != null || _post == null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="my-8">
            @(_errorMessage ?? "The requested article could not be found.")
        </MudAlert>
    }
    else
    {
        <PageTitle>@_post.Title — Trash Tech Hub</PageTitle>
        <HeadContent>
            <meta name="description" content="@_post.Excerpt" />
            <link rel="canonical" href="https://trashtechhub.com/blog/@_post.Slug" />
            <!-- Open Graph -->
            <meta property="og:title" content="@_post.Title — Trash Tech Hub" />
            <meta property="og:description" content="@_post.Excerpt" />
            <meta property="og:type" content="article" />
            <meta property="og:url" content="https://trashtechhub.com/blog/@_post.Slug" />
            <meta property="og:image" content="https://trashtechhub.com/Images/trash-tech-hub-logo-bg-removed.png" />
            <meta property="article:published_time" content="@_post.Created.ToString("o")" />
            @if (_post.Updated.HasValue)
            {
                <meta property="article:modified_time" content="@_post.Updated.Value.ToString("o")" />
            }
            <meta property="article:section" content="@(_post.Category?.Title ?? "General")" />
            <!-- Twitter Card -->
            <meta name="twitter:card" content="summary_large_image" />
            <meta name="twitter:title" content="@_post.Title" />
            <meta name="twitter:description" content="@_post.Excerpt" />
            <meta name="twitter:image" content="https://trashtechhub.com/Images/trash-tech-hub-logo-bg-removed.png" />
            
            <script type="application/ld+json">
            {
              "@@context": "https://schema.org",
              "@@type": "BlogPosting",
              "headline": @System.Text.Json.JsonSerializer.Serialize(_post.Title),
              "description": @System.Text.Json.JsonSerializer.Serialize(_post.Excerpt),
              "author": {
                "@@type": "Person",
                "name": "Luis Magno Terranova"
              },
              "datePublished": "@_post.Created.ToString("o")",
              "dateModified": "@((_post.Updated ?? _post.Created).ToString("o"))",
              "mainEntityOfPage": {
                "@@type": "WebPage",
                "@@id": "https://trashtechhub.com/blog/@_post.Slug"
              }
            }
            </script>
        </HeadContent>

        <article class="blog-article">
            <!-- Article Header Metadata -->
            <header class="mb-8">
                <div class="d-flex align-center flex-wrap gap-4 mb-4">
                    <MudChip T="string" Color="Color.Tertiary" Variant="Variant.Outlined" Size="Size.Small" Class="font-weight-bold">
                        @(_post.Category?.Title ?? "General")
                    </MudChip>
                    <span style="color: var(--mud-palette-text-secondary); font-size: 0.9rem;">
                        Published on @_post.Created.ToString("MMMM dd, yyyy")
                    </span>
                    @if (_post.Updated > _post.Created)
                    {
                        <span style="color: var(--mud-palette-text-secondary); font-size: 0.85rem; font-style: italic;">
                            (Updated: @_post.Updated?.ToString("MMMM dd, yyyy"))
                        </span>
                    }
                </div>
                <MudText Typo="Typo.h3" HtmlTag="h1" Color="Color.Primary" Class="font-weight-800 mb-6" Style="line-height: 1.15;">
                    @_post.Title
                </MudText>
                <MudDivider Style="background-color: var(--mud-palette-divider);" />
            </header>

            <!-- Markdown Rendered Body -->
            <div class="article-content py-4">
                <MarkdownRenderer Content="@_post.Body" />
            </div>
            
            <footer class="mt-12 pt-6" style="border-top: 1px solid var(--mud-palette-lines-default);">
                <MudGrid Justify="Justify.SpaceBetween" Class="align-center">
                    <MudItem>
                        <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">
                            Category: @(_post.Category?.Title ?? "None")
                        </MudText>
                    </MudItem>
                    <MudItem>
                        <!-- Share or comments spacer -->
                    </MudItem>
                </MudGrid>
            </footer>
        </article>
    }
</MudContainer>

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    private PostDto? _post;
    private bool _isLoading = true;
    private string? _errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        await LoadPost();
    }

    private async Task LoadPost()
    {
        _isLoading = true;
        _errorMessage = null;
        try
        {
            _post = await PostService.GetBySlugAsync(Slug);

            if (_post == null)
                _errorMessage = "Article not found.";
        }
        catch
        {
            _errorMessage = "An error occurred while loading this article.";
        }
        finally
        {
            _isLoading = false;
        }
    }
}

